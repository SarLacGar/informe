<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informe de ofertas"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textoCiudad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Ciudad"
        android:textSize="18sp" />
    <!--elegir el filtro-->
    <Spinner
        android:id="@+id/spinnerCiudad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/botonGenerarInforme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Generar informe" />

    <Button
        android:id="@+id/botonExportarPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Exportar PDF" />

    <!--resumen del informe-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedorInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFC5"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- Resumen -->
            <TextView
                android:id="@+id/textoCiudadSeleccionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ciudad seleccionada: -"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoNumeroOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Numero de ofertas: -"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoSalarioTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salario total: -"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoSalarioMedio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salario medio: -"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoSalarioMinimo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salario mínimo: -"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textoSalarioMaximo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salario máximo: -"
                android:textSize="16sp" />

            <!-- representación de resultados -->
            <TextView
                android:id="@+id/textoTituloGrafico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ofertas por ciudad"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Barra Valencia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Valencia"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/barraValencia"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadValencia"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Barra Madrid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Madrid"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/barraMadrid"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadMadrid"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Barra Alicante -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="Alicante"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/barraAlicante"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="20dp"
                        android:layout_weight="1"
                        android:indeterminate="false"
                        android:max="1"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/textoCantidadAlicante"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="0"
                        android:textSize="16sp" />
                </LinearLayout>


            <!-- Barra Barcelona -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="Barcelona"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/barraBarcelona"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:indeterminate="false"
                    android:max="1"
                    android:progress="0" />

                <TextView
                    android:id="@+id/textoCantidadBarcelona"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

            <!-- Listado -->
            <TextView
                android:id="@+id/textoTituloListado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ofertas"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>